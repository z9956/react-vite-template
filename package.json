{
  "name": "react-vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode development",
    "dev:prod": "vite --host 0.0.0.0 --mode production",
    "dev:staging": "vite --host 0.0.0.0 --mode staging",
    "build": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "lint": "bun lint:fix && bun lint:prettier",
    "lint:prettier": "prettier --write",
    "lint:fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "antd": "^5.17.0",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "i18next": "^23.11.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-i18next": "^14.1.1",
    "react-icons": "^5.1.0",
    "react-router-dom": "^6.22.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "less": "^4.2.0",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "vite": "^6.0.5"
  },
  "volta": {
    "node": "22.11.0"
  }
}
